[
 {
  "text": "December, eighteen seventy-two.",
  "start": 0.35,
  "end": 2.7583333333333333
 },
 {
  "text": "A crew spots a ship drifting in the middle of the Atlantic...",
  "start": 3.058333333333333,
  "end": 6.771333333333333
 },
 {
  "text": "with no one at the wheel.",
  "start": 7.021333333333333,
  "end": 8.914666666666665
 },
 {
  "text": "They row over. They call out.",
  "start": 9.414666666666665,
  "end": 11.592208333333332
 },
 {
  "text": "Nothing.",
  "start": 11.992208333333332,
  "end": 12.872374999999998
 },
 {
  "text": "On board, there's six months of food and water.",
  "start": 13.472374999999998,
  "end": 16.362624999999998
 },
 {
  "text": "The crew's belongings, still in their quarters.",
  "start": 16.562624999999997,
  "end": 19.267249999999997
 },
 {
  "text": "But every single person is gone.",
  "start": 19.567249999999998,
  "end": 21.823249999999998
 },
 {
  "text": "The captain. His wife. Their two-year-old daughter. And the crew.",
  "start": 22.273249999999997,
  "end": 26.44170833333333
 },
 {
  "text": "The only lifeboat? Missing.",
  "start": 26.89170833333333,
  "end": 29.062291666666663
 },
 {
  "text": "A rope, it's said, trailed from the ship... into the sea.",
  "start": 29.412291666666665,
  "end": 33.065875
 },
 {
  "text": "The last log entry was written ten days earlier, near the Azores...",
  "start": 33.565875,
  "end": 37.937999999999995
 },
 {
  "text": "hundreds of miles away.",
  "start": 38.138,
  "end": 40.07358333333333
 },
 {
  "text": "It gave no hint of trouble.",
  "start": 40.37358333333333,
  "end": 42.427208333333326
 },
 {
  "text": "Not one of them was ever seen again.",
  "start": 42.87720833333333,
  "end": 45.62354166666666
 },
 {
  "text": "So tell me...",
  "start": 46.22354166666666,
  "end": 47.36383333333333
 },
 {
  "text": "what makes a whole family abandon a perfectly good ship?",
  "start": 47.66383333333333,
  "end": 51.421791666666664
 }
]