[
 {
  "text": "January, nineteen sixty-two. Tanganyika, East Africa.",
  "start": 0.35,
  "end": 4.5798749999999995
 },
 {
  "text": "At a girls' boarding school near Lake Victoria...",
  "start": 4.879874999999999,
  "end": 7.8380416666666655
 },
 {
  "text": "three students start to laugh.",
  "start": 8.038041666666665,
  "end": 10.262583333333332
 },
 {
  "text": "And they can't stop.",
  "start": 10.762583333333332,
  "end": 12.212458333333332
 },
 {
  "text": "Within weeks, ninety-five of the girls are caught in it.",
  "start": 12.762458333333333,
  "end": 15.967666666666666
 },
 {
  "text": "Fits that last for hours... sometimes days.",
  "start": 16.217666666666666,
  "end": 19.319583333333334
 },
 {
  "text": "Crying. Fainting. Restlessness.",
  "start": 19.619583333333335,
  "end": 22.054625
 },
 {
  "text": "In March, the school gives up and closes its doors.",
  "start": 22.454625,
  "end": 25.696625
 },
 {
  "text": "The girls are sent home...",
  "start": 25.946625,
  "end": 27.858625
 },
 {
  "text": "and the laughter goes with them.",
  "start": 28.158625,
  "end": 30.355208333333334
 },
 {
  "text": "In one nearby village, more than two hundred people are struck.",
  "start": 30.905208333333334,
  "end": 34.391041666666666
 },
 {
  "text": "Other schools shut down too.",
  "start": 34.641041666666666,
  "end": 36.67520833333333
 },
 {
  "text": "Doctors test for poison. For infection.",
  "start": 37.02520833333333,
  "end": 39.78554166666667
 },
 {
  "text": "They find nothing.",
  "start": 40.185541666666666,
  "end": 41.69658333333333
 },
 {
  "text": "By some accounts, it lingered for a year and a half.",
  "start": 42.29658333333333,
  "end": 45.690416666666664
 },
 {
  "text": "Today, experts blame stress... spreading from mind to mind.",
  "start": 45.99041666666666,
  "end": 49.959958333333326
 },
 {
  "text": "So tell me...",
  "start": 50.40995833333333,
  "end": 51.55025
 },
 {
  "text": "could you catch a laugh you couldn't stop?",
  "start": 51.850249999999996,
  "end": 54.378499999999995
 }
]